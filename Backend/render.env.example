# ─── Render Environment Reference ─────────────────────────────────────
# Deploy: Render Dashboard → New Web Service → Select Backend repo
#         Render auto-detects Dockerfile, builds & deploys.
#
# PostgreSQL: External (Neon free tier)
# Redis:      External (Upstash free tier)
#
# Set these env vars in Render Dashboard → Environment tab:
# ─────────────────────────────────────────────────────────────────────

# ── Required ──
DATABASE_URL=           # Neon PostgreSQL connection string
REDIS_URL=              # Upstash Redis URL (rediss://...)
CORS_ORIGIN=            # Frontend URL (https://xxx.onrender.com)

# ── Auth (auto-generate in dashboard) ──
JWT_SECRET=             # Generate random value
JWT_REFRESH_SECRET=     # Generate random value

# ── Optional: SMTP ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Optional: Cloudinary ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
