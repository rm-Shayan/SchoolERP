PORT=3000
# Production (Neon/Supabase/RDS): use sslmode=verify-full for cert verification
# Local dev: sslmode is auto-appended as 'disable' if not specified
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Legacy
JWT_EXPIRY=24h

# Environment: development | production
NODE_ENV=development

# Daily cleanup job (3:00 AM): retention windows (din) — is se purane records delete
AUDIT_LOG_RETENTION_DAYS=180
NOTIFICATION_LOG_RETENTION_DAYS=90

# Monthly attendance archive job (1st of month 3:30 AM): 365 din se purani
# attendance per-student yearly summary mein roll-up hokar delete ho jati hai
ATTENDANCE_ARCHIVE_AFTER_DAYS=365

# Redis — self-hosted Docker container (Backend/docker/redis/Dockerfile)
# Build:  docker build -t school-redis Backend/docker/redis
# Run:    docker run -d --name school-redis -p 127.0.0.1:6379:6379 \
#           -e REDIS_PASSWORD=PASSWORD -v school-redis-data:/data school-redis
#          (127.0.0.1 bind zaroori hai — 0.0.0.0 par port LAN/internet par khulta hai)
REDIS_URL="redis://:PASSWORD@localhost:6379"
# (Upstash cloud ke liye: REDIS_URL="rediss://default:PASSWORD@HOST:PORT")

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME="School ERP Pakistan"

# Public base URL of the backend — used to build absolute /uploads/... image
# URLs inside emails (local-disk logos otherwise break in mail clients).
# Falls back to CLIENT_URL when unset. Example: https://api.school.com
API_URL=

# Image upload limit in MB for Cloudinary/local image storage
MAX_IMAGE_UPLOAD_SIZE_MB=5

# WhatsApp Business Cloud API (optional — primary channel when enabled)
# When enabled, parent notifications also deliver the school/org logo (image)
# and PDF attachments (admission slip / ID card / fee receipt) as documents.
# When disabled/unset, parents receive notifications via Email and WhatsApp
# delivery is simulated in dev logs. See src/config/whatsapp.js.
WA_ENABLED=false
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_WEBHOOK_VERIFY_TOKEN=
WA_DEFAULT_SENDER=
WA_API_BASE_URL=https://graph.facebook.com/v21.0

# Tenant storage creds encryption (AES-256-GCM master key, 64-char hex).
# Missing ho to JWT_SECRET se derive hoti hai (dev-only).
# MAIL_ENC_KEY=

