# ==================================================================
# LOCAL DEVELOPMENT ENV — NODE_ENV=local ke saath ye file load hoti hai
# (src/config/env.js). Values local services ko point karti hain:
# local Postgres + local Docker Redis. Production values (.env) se
# BILKUL alag hain — ye file git me commit hoti hai, koi real secret nahi.
# ==================================================================

NODE_ENV=development
PORT=5000

# ── Database: LOCAL Postgres ──────────────────────────────────────
# Local Postgres me pehle database banao:  CREATE DATABASE schoolerp;
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schoolerp

# ── Auth (dev-only values — production .env me real secret hai) ───
JWT_SECRET=local_dev_only_secret_change_me_0123456789
JWT_EXPIRY=24h

# ── Redis: LOCAL Docker container ─────────────────────────────────
# Build:  docker build -t school-redis Backend/docker/redis
# Run:    docker run -d --name school-redis --restart unless-stopped \
#           -p 127.0.0.1:6379:6379 -e REDIS_PASSWORD=localpass \
#           -v school-redis-data:/data school-redis
# Password ke saath: redis://:localpass@localhost:6379
REDIS_URL=redis://localhost:6379

# ── SMTP (local) ──────────────────────────────────────────────────
# Local par real credentials ki zaroorat nahi: verification skip hoti hai
# aur bina tenant SMTP ke school mail outbox me queue hoti hai (correct
# behavior test karne ke liye theek hai).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SKIP_CREDENTIAL_VERIFICATION=true
EMAIL_FROM_NAME="School ERP Local"

# ── URLs ──────────────────────────────────────────────────────────
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# ── Jobs retention (local = chhoti values bhi chalengi) ───────────
AUDIT_LOG_RETENTION_DAYS=180
NOTIFICATION_LOG_RETENTION_DAYS=90
ATTENDANCE_ARCHIVE_AFTER_DAYS=365

# ── Misc ──────────────────────────────────────────────────────────
MAX_IMAGE_UPLOAD_SIZE_MB=5
WA_ENABLED=false
# Tenant storage encryption: local par JWT_SECRET se derive hoti hai.
# MAIL_ENC_KEY=
